DOMAIN=medvision.example.com
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=medvision.example.com
CSRF_TRUSTED_ORIGINS=https://medvision.example.com
DATABASE_URL=postgresql://medai:replace-db-password@db:5432/medai
POSTGRES_DB=medai
POSTGRES_USER=medai
POSTGRES_PASSWORD=replace-db-password
MAX_UPLOAD_MB=50
INFERENCE_MODE=mock
INFERENCE_WORKERS=1
MONAI_MODEL_PATH=
MONAI_MODEL_NAME=BraTS MONAI UNet
MONAI_MODEL_VERSION=unconfigured
MONAI_MIXED_PRECISION=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=3600
